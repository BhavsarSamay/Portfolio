# Contact form email settings. Copy this file to .env.local and fill in the values.
# .env.local is git-ignored, so your real key is never pushed.
# On Vercel, add the same three names under Project > Settings > Environment Variables instead.

# Your Resend API key (https://resend.com/api-keys). Starts with "re_".
RESEND_API_KEY=

# The inbox that should receive messages from the form.
# With Resend's free test sender this must be the email you signed up to Resend with.
CONTACT_TO_EMAIL=

# Optional. Leave blank to use Resend's test sender "Portfolio Contact <onboarding@resend.dev>".
# Once you verify your own domain in Resend you can use e.g. "Portfolio <contact@yourdomain.com>".
CONTACT_FROM_EMAIL=
